  "item": [
    {
      "name": "Create User",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "let jsonData = pm.response.json();\r",
              "\r",
              "// Store ID in Environment Variable\r",
              "pm.environment.set(\"env_id\", jsonData.id);\r",
              "\r",
              "// Status Code Assertion\r",
              "pm.test(\"Status code is 201\", () => {\r",
              "    pm.response.to.have.status(201);\r",
              "});\r",
              "\r",
              "// Header Assertion\r",
              "pm.test(\"Content-Type header is application/json\", () => {\r",
              "    pm.expect(pm.response.headers.get(\"Content-Type\"))\r",
              "        .to.eql(\"application/json; charset=utf-8\");\r",
              "});\r",
              "\r",
              "// Response Time Assertion\r",
              "pm.test(\"Response time is less than 600ms\", () => {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(600);\r",
              "});\r",
              "\r",
              "// Data Type Validation\r",
              "pm.test(\"Validate response data types\", () => {\r",
              "    pm.expect(jsonData).to.be.an(\"object\");\r",
              "    pm.expect(jsonData.id).to.be.a(\"number\");\r",
              "    pm.expect(jsonData.name).to.be.a(\"string\");\r",
              "    pm.expect(jsonData.email).to.be.a(\"string\");\r",
              "    pm.expect(jsonData.gender).to.be.a(\"string\");\r",
              "    pm.expect(jsonData.status).to.be.a(\"string\");\r",
              "});\r",
              "\r",
              "// Response Body Validation\r",
              "pm.test(\"Validate response body values\", () => {\r",
              "    pm.expect(jsonData.name).to.eql(\"{{username_env}}\");\r",
              "    pm.expect(jsonData.email).to.eql(\"{{email_env}}\");\r",
              "    pm.expect(jsonData.gender).to.eql(\"male\");\r",
              "    pm.expect(jsonData.status).to.eql(\"active\");\r",
              "    pm.expect(jsonData.id).to.exist;\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "//create  random email\r",
              "var random = Math.random().toString(36).substring(2);\r",
              "\r",
              "var email = \"Donbanegajon\"+random + \"@gmail.com\";\r",
              "var username = \"Donbanegajon\"+random;\r",
              "\r",
              "pm.environment.set(\"email_env\", email);\r",
              "pm.environment.set(\"username_env\", username);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
