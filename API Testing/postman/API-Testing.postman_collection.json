        },
        {
          "name": "GetOrderById",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const orderId = pm.environment.get('orderId') || pm.collectionVariables.get('orderId');",
                  "pm.test('[Pre] orderId is set', () => {",
                  "    pm.expect(orderId, 'Run Create Orders first').to.be.a('string').and.not.empty;",
                  "});"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
