    {
      "name": "Orders",
      "item": [
        {
          "name": "Create Orders",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// ========== PRE: Create Order ==========",
                  "const getVar = (k) => pm.environment.get(k) || pm.collectionVariables.get(k);",
                  "const userId = getVar('userId');",
                  "const email = getVar('userEmail') || 'darshan@example.com';",
                  "",
                  "pm.collectionVariables.set('orderCustomerName', 'Darshan');",
                  "pm.collectionVariables.set('orderCustomerEmail', email);",
                  "",
                  "pm.test('[Pre] accessToken exists', () => {",
                  "    pm.expect(getVar('accessToken'), 'Login or Register first').to.be.a('string').and.not.empty;",
                  "});",
                  "",
                  "pm.test('[Pre] userId is set', () => {",
                  "    pm.expect(userId, 'userId required for order').to.be.a('string').and.not.empty;",
                  "});"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// ========== POST: Create Order assertions ==========",
                  "",
                  "pm.test('Status code is 201 Created', () => pm.response.to.have.status(201));",
                  "",
                  "const res = pm.response.json();",
                  "",
                  "pm.test('Order created success message', () => {",
                  "    pm.expect(res.message).to.eql('order created successfully');",
                  "    pm.expect(res.defaultStatus).to.eql('pending');",
                  "});",
                  "",
                  "pm.test('Order has pending status by default', () => {",
                  "    pm.expect(res.order.status).to.eql('pending');",
                  "});",
                  "",
                  "pm.test('Order structure is valid', () => {",
                  "    pm.expect(res.order).to.have.keys(",
                  "        'id', 'userId', 'customerName', 'customerEmail',",
                  "        'items', 'status', 'total', 'shippingAddress',",
                  "        'notes', 'createdAt', 'updatedAt'",
                  "    );",
                  "});",
                  "",
                  "pm.test('Order items and total are correct', () => {",
                  "    pm.expect(res.order.items).to.be.an('array').that.is.not.empty;",
                  "    pm.expect(res.order.total).to.be.a('number');",
                  "    pm.expect(res.order.total).to.eql(39.98);",
                  "});",
                  "",
                  "pm.test('Order linked to userId', () => {",
                  "    pm.expect(res.order.userId).to.eql(pm.collectionVariables.get('userId'));",
                  "});",
                  "",
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('orderId', res.order.id);",
                  "    pm.environment.set('orderId', res.order.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"customerName\": \"{{orderCustomerName}}\",\n  \"customerEmail\": \"{{orderCustomerEmail}}\",\n  \"items\": [\n    { \"name\": \"Widget\", \"quantity\": 2, \"price\": 19.99 }\n  ],\n  \"shippingAddress\": {\n    \"street\": \"123 Main St\",\n    \"city\": \"Mumbai\",\n    \"state\": \"MH\",\n    \"zip\": \"400001\",\n    \"country\": \"IN\"\n  },\n  \"notes\": \"Leave at door\"\n}"
            },
            "url": "{{Url_env}}/api/orders"
          }
        },
