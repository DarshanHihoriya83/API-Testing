{
  "info": {
    "name": "API Testing Backend",
    "description": "Full pre-request validation + post-response assertions.\n\nEnvironment variables: Url_env, API_KEY, password, userEmail\n\nRun order: Create user → Create Orders → other requests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "Url_env", "value": "http://localhost:3000" },
    { "key": "API_KEY", "value": "your-api-key-here" },
    { "key": "password", "value": "Darshan@123" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "orderId", "value": "" },
    { "key": "registerEmail", "value": "" },
    { "key": "registerName", "value": "" },
    { "key": "userEmail", "value": "darshan@example.com" },
    { "key": "orderCustomerName", "value": "Darshan" },
    { "key": "orderCustomerEmail", "value": "" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// ========== COLLECTION PRE-REQUEST (every request) ==========",
          "",
          "const getVar = (key) => pm.environment.get(key) || pm.collectionVariables.get(key);",
          "",
          "// Validate base URL",
          "const baseUrl = getVar('Url_env');",
          "pm.test('[Pre] Url_env is set', () => {",
          "    pm.expect(baseUrl, 'Set Url_env in environment').to.be.a('string').and.not.empty;",
          "});",
          "",
          "// Auto-attach API key",
          "const apiKey = getVar('API_KEY');",
          "if (apiKey) {",
          "    pm.request.headers.upsert({ key: 'x-api-key', value: apiKey });",
          "} else {",
          "    console.warn('[Pre] Missing API_KEY');",
          "}",
          "",
          "// Auto-attach JWT for protected routes",
          "const publicPaths = ['/api/register', '/api/login', '/api/auth/refresh'];",
          "const requestUrl = pm.request.url.toString();",
          "const isPublic = publicPaths.some((p) => requestUrl.includes(p));",
          "",
          "if (!isPublic) {",
          "    const token = getVar('accessToken');",
          "    if (token) {",
          "        pm.request.headers.upsert({ key: 'Authorization', value: `Bearer ${token}` });",
          "    } else {",
          "        console.warn('[Pre] No accessToken — run Create user or Login first');",
          "    }",
          "}",
          "",
          "// Ensure Content-Type for JSON bodies",
          "if (pm.request.body && pm.request.body.mode === 'raw' && pm.request.body.raw) {",
          "    pm.request.headers.upsert({ key: 'Content-Type', value: 'application/json' });",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// ========== COLLECTION TESTS (every request) ==========",
          "",
          "pm.test('[Global] Response time under 3s', () => {",
          "    pm.expect(pm.response.responseTime).to.be.below(3000);",
          "});",
          "",
          "pm.test('[Global] Response has valid JSON body', () => {",
          "  if (pm.response.text && pm.response.text.length > 0) {",
          "    pm.response.to.be.json;",
          "  }",
          "});",
          "",
          "pm.test('[Global] Content-Type is application/json', () => {",
          "  if (pm.response.text && pm.response.text.length > 0 && pm.response.code !== 204) {",
          "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
          "  }",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Create user",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// ========== PRE: Register ==========",
                  "const ts = Date.now();",
                  "const email = `darshan+${ts}@example.com`;",
                  "const name = `Darshan${ts}`;",
                  "const password = pm.environment.get('password') || pm.collectionVariables.get('password');",
                  "",
                  "pm.collectionVariables.set('registerEmail', email);",
                  "pm.collectionVariables.set('registerName', name);",
                  "",
                  "pm.test('[Pre] password is at least 8 chars', () => {",
                  "    pm.expect(password, 'Set password variable').to.have.lengthOf.at.least(8);",
                  "});",
                  "",
                  "pm.test('[Pre] generated email is valid', () => {",
                  "    pm.expect(email).to.match(/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/);",
                  "});",
                  "",
                  "console.log('[Pre] Register:', email);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// ========== POST: Register assertions ==========",
                  "",
                  "pm.test('Status code is 201 Created', () => {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const res = pm.response.json();",
                  "",
                  "pm.test('Response has user object', () => {",
                  "    pm.expect(res).to.have.property('user');",
                  "    pm.expect(res.user).to.have.keys('id', 'name', 'email', 'createdAt', 'updatedAt');",
                  "});",
                  "",
                  "pm.test('User email matches request', () => {",
                  "    const expected = pm.collectionVariables.get('registerEmail');",
                  "    pm.expect(res.user.email).to.eql(expected);",
                  "});",
                  "",
                  "pm.test('User has no password in response', () => {",
                  "    pm.expect(res.user).to.not.have.property('password');",
                  "    pm.expect(res.user).to.not.have.property('passwordHash');",
                  "});",
                  "",
                  "pm.test('JWT tokens are returned', () => {",
                  "    pm.expect(res.accessToken).to.be.a('string').and.not.empty;",
                  "    pm.expect(res.refreshToken).to.be.a('string').and.not.empty;",
                  "    pm.expect(res.tokenType).to.eql('Bearer');",
                  "    pm.expect(res.expiresIn).to.eql('1h');",
                  "});",
                  "",
                  "pm.test('Success message is present', () => {",
                  "    pm.expect(res.message).to.eql('registered successfully');",
                  "});",
                  "",
                  "// Save for chained requests",
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('accessToken', res.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', res.refreshToken);",
                  "    pm.collectionVariables.set('userId', res.user.id);",
                  "    pm.collectionVariables.set('userEmail', res.user.email);",
                  "    pm.environment.set('accessToken', res.accessToken);",
                  "    pm.environment.set('userId', res.user.id);",
                  "    pm.environment.set('userEmail', res.user.email);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{registerName}}\",\n  \"email\": \"{{registerEmail}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{Url_env}}/api/register"
          }
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// ========== PRE: Login ==========",
                  "const getVar = (k) => pm.environment.get(k) || pm.collectionVariables.get(k);",
                  "const email = getVar('userEmail');",
                  "const password = getVar('password');",
                  "",
                  "pm.test('[Pre] userEmail is set', () => {",
                  "    pm.expect(email, 'Set userEmail or run Create user first').to.be.a('string').and.not.empty;",
                  "});",
                  "",
                  "pm.test('[Pre] password is set', () => {",
                  "    pm.expect(password, 'Set password variable').to.be.a('string').and.not.empty;",
                  "});",
                  "",
                  "pm.test('[Pre] email format is valid', () => {",
                  "    pm.expect(email).to.match(/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/);",
                  "});"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// ========== POST: Login assertions ==========",
                  "",
                  "pm.test('Status code is 200 OK', () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const res = pm.response.json();",
                  "",
                  "pm.test('Response has user and tokens', () => {",
                  "    pm.expect(res.user).to.have.property('id');",
                  "    pm.expect(res.user).to.have.property('email');",
                  "    pm.expect(res.accessToken).to.be.a('string').and.not.empty;",
                  "    pm.expect(res.refreshToken).to.be.a('string').and.not.empty;",
                  "});",
                  "",
                  "pm.test('Login success message', () => {",
                  "    pm.expect(res.message).to.eql('logged in successfully');",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    pm.collectionVariables.set('accessToken', res.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', res.refreshToken);",
                  "    pm.collectionVariables.set('userId', res.user.id);",
                  "    pm.collectionVariables.set('userEmail', res.user.email);",
                  "    pm.environment.set('accessToken', res.accessToken);",
                  "    pm.environment.set('refreshToken', res.refreshToken);",
                  "    pm.environment.set('userId', res.user.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{Url_env}}/api/login"
          }
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const refreshToken = pm.environment.get('refreshToken') || pm.collectionVariables.get('refreshToken');",
                  "pm.test('[Pre] refreshToken exists', () => {",
                  "    pm.expect(refreshToken, 'Run Login or Register first').to.be.a('string').and.not.empty;",
                  "});"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', () => pm.response.to.have.status(200));",
                  "",
                  "const res = pm.response.json();",
                  "",
                  "pm.test('New tokens issued', () => {",
                  "    pm.expect(res.accessToken).to.be.a('string').and.not.empty;",
                  "    pm.expect(res.refreshToken).to.be.a('string').and.not.empty;",
                  "    pm.expect(res.message).to.eql('token refreshed');",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    pm.collectionVariables.set('accessToken', res.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', res.refreshToken);",
                  "    pm.environment.set('accessToken', res.accessToken);",
                  "    pm.environment.set('refreshToken', res.refreshToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{Url_env}}/api/auth/refresh"
          }
        },
        {
