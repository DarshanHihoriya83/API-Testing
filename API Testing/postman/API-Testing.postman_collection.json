                  "pm.test('Returns current user profile', () => {",
                  "    pm.expect(res.user).to.have.keys('id', 'name', 'email', 'createdAt', 'updatedAt');",
                  "    pm.expect(res.user.id).to.eql(pm.collectionVariables.get('userId'));",
                  "});"
                ],
